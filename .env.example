# Copy to .env and fill in real values. NEVER commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require"

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN_DAYS=30

# OTP
OTP_TTL_SECONDS=300
OTP_RESEND_AFTER_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15

# throttling
OTP_GENERATE_MAX_PER_WINDOW=5
OTP_GENERATE_WINDOW_SECONDS=600

# AWS S3 file storage (extension phase — see BUILD_LOG.md). Never put real
# credentials in this file.
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=change-me

# SMTP email delivery (OTP emails for login/sign-up). Never put real
# credentials in this file.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=change-me
EMAIL_PASSWORD=change-me
EMAIL_FROM=change-me
